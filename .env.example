# Base URL voor de backend API; laat leeg om lokale mockdata te gebruiken.
VITE_API_BASE_URL=

# Optioneel: schakel mock data expliciet in/uit (default: aan als VITE_API_BASE_URL leeg is).
VITE_USE_MOCK=true

# Authenticatie: mock, api of firebase. De standaard volgt VITE_USE_MOCK.
VITE_AUTH_PROVIDER=mock

# Publieke Firebase Web App-configuratie; vereist voor VITE_AUTH_PROVIDER=firebase.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
